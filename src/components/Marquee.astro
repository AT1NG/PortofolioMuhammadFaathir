---
interface Props { items: string[]; label: string }
const { items, label } = Astro.props;
---
<section aria-label={label} class="marquee edge-fade overflow-hidden border-y border-line py-5" tabindex="0">
  <div class="marquee-track" style="--marquee-d: 42s">
    {[0, 1].map((n) => (
      <ul class:list={['flex shrink-0 items-center', n === 1 && 'marquee-dup']} aria-hidden={n === 1 ? 'true' : undefined}>
        {items.map((s) => (
          <li class="flex items-center font-display text-2xl font-bold tracking-tight sm:text-3xl">
            <span class="px-6 sm:px-9">{s}</span><svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5 text-accent" fill="currentColor"><path d="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4z"/></svg>
          </li>
        ))}
      </ul>
    ))}
  </div>
</section>
